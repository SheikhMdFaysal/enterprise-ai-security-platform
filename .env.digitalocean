# DigitalOcean Environment Variables
# Set these in DigitalOcean App Platform dashboard under Settings > App-Level Environment Variables

# Database (auto-configured by DigitalOcean managed database)
# DATABASE_URL is automatically set when you attach a managed database

# AI Model API Keys (set as encrypted secrets in DO dashboard)
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
GOOGLE_API_KEY=your-google-api-key

# Application
ENVIRONMENT=production
SECRET_KEY=generate-a-strong-random-key-here
API_KEYS=generate-a-strong-api-key-here

# Models
OPENAI_MODELS=gpt-4,gpt-4-turbo
ANTHROPIC_MODELS=claude-3-opus-20240229,claude-3-5-sonnet-20240620
GOOGLE_MODELS=gemini-2.0-flash,gemini-2.5-flash

# CORS (will be set to your DigitalOcean app URL)
ALLOWED_ORIGINS=https://your-app.ondigitalocean.app
